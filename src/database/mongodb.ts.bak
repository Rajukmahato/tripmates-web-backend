/**
 * Database Configuration & Connection Pooling
 * Optimized MongoDB connection setup
 */

import mongoose from 'mongoose';
import { MONGODB_URI } from '../configs';

/**
 * MongoDB connection options with pooling
 * Optimizes connection management for production
 */
const mongooseOptions: mongoose.ConnectOptions = {
    // Connection pooling
    minPoolSize: 10, // Minimum connections in pool
    maxPoolSize: 50, // Maximum connections in pool

    // Timeouts
    connectTimeoutMS: 10000, // 10 seconds
    socketTimeoutMS: 45000, // 45 seconds
    serverSelectionTimeoutMS: 5000, // 5 seconds

    // Retries
    retryWrites: true, // Automatic retry on failure
    retryReads: true, // Automatic retry on read failure

    // Connection monitoring
    heartbeatFrequencyMS: 10000, // Monitor connection every 10s

    // Read preferences
    readPreference: 'primary', // Always read from primary
    readConcern: { level: 'majority' }, // Strong consistency

    // Write concerns
    writeConcern: { w: 'majority', j: true }, // Ensure writes are journaled

    // Connection string options
    authSource: 'admin',
    retryWrites: true,
    w: 'majority',
    journal: true,

    // Auto index creation (disable in production)
    autoIndex: process.env.NODE_ENV !== 'production',
};

/**
 * Connect to MongoDB with connection pooling
 */
export const connectDb = async (): Promise<void> => {
    try {
        console.log('🔌 Connecting to MongoDB with connection pooling...');
        console.log(`📍 Database URI: ${MONGODB_URI.replace(/:[^:]*@/, ':****@')}`);

        // Create connection with optimized options
        await mongoose.connect(MONGODB_URI, mongooseOptions);

        // Get connection stats
        const connection = mongoose.connection;
        
        console.log('✅ MongoDB connected successfully');
        console.log(`📊 Connection Pool Status:`);
        console.log(`   - Ready State: ${connection.readyState}`);
        console.log(`   - Host: ${connection.host}`);
        console.log(`   - Port: ${connection.port}`);
        console.log(`   - Database: ${connection.name}`);

        // Listen for connection events
        connection.on('disconnected', () => {
            console.warn('⚠️ MongoDB disconnected');
        });

        connection.on('reconnected', () => {
            console.log('✅ MongoDB reconnected');
        });

        connection.on('error', (error) => {
            console.error('❌ MongoDB error:', error);
        });

    } catch (error) {
        console.error('❌ Failed to connect to MongoDB:', error);
        process.exit(1);
    }
};

/**
 * Graceful shutdown - close database connection
 */
export const disconnectDb = async (): Promise<void> => {
    try {
        await mongoose.connection.close();
        console.log('✅ MongoDB disconnected gracefully');
    } catch (error) {
        console.error('❌ Error disconnecting from MongoDB:', error);
        process.exit(1);
    }
};

/**
 * Get connection stats for monitoring
 */
export const getConnectionStats = () => {
    const connection = mongoose.connection;
    return {
        readyState: connection.readyState,
        host: connection.host,
        port: connection.port,
        database: connection.name,
        collections: connection.collections,
        models: connection.modelNames(),
    };
};

/**
 * Health check for database
 */
export const checkDatabaseHealth = async (): Promise<boolean> => {
    try {
        // Ping the database
        await mongoose.connection.db?.admin().ping();
        return true;
    } catch (error) {
        console.error('Database health check failed:', error);
        return false;
    }
};
